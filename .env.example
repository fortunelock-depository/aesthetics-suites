NODE_ENV=development

# Postgres connection string (required - the app fails fast at startup without it)
DATABASE_URL=postgresql://user:password@localhost:5432/aesthetics_suites

# Secret used to sign session + 2FA-pending JWTs. Minimum 32 characters -
# generate with: openssl rand -hex 32
SESSION_SECRET=generate_with_openssl_rand_hex_32

# First admin - used ONLY by `npm run seed` (prisma/seed.ts). These do NOT need
# to be present in the deployed app environment; set them locally (or in a
# one-off job) when seeding, with a strong unique password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use-a-long-unique-password
ADMIN_FULLNAME="Admin Name"
ADMIN_PHONE=233000000000
ADMIN_SEED_ENABLED=false
ADMIN_SEED_FORCE_UPDATE=false

# Demo content: 4 published room types with units + free Unsplash photos
# (matches the landing page imagery). For local dev / staging demos.
DEMO_SEED_ENABLED=false

# Public site origin - canonical URLs, sitemap, OG URLs, and absolute links in
# emails. REQUIRED in production (the build fails without it).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional in development - when unset, 2FA codes / reset links are printed to
# the server console instead of emailed. Set in production (Gmail App Password).
# Email SMTP (Gmail: host smtp.gmail.com, port 587, an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_smtp_or_app_password
SMTP_SECURE=false
EMAIL_FROM_NAME="Aesthetics Suites"
MAIL_FROM_EMAIL=

# Optional in development - when unset, an in-memory rate limiter is used.
# REQUIRED in production: without Upstash the limiter FAILS CLOSED (login and
# password reset are rejected) rather than silently running with no
# cross-instance protection.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudinary - room/gallery image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=aesthetics-suites

# Cloudflare Turnstile - bot protection on the public forms. Optional in
# development (forms fall back to honeypot-only); set BOTH in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Paystack - booking payments. Use test keys locally.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Where Paystack sends the guest back after paying (defaults to
# NEXT_PUBLIC_BASE_URL/payments/verify when unset).
PAYSTACK_CALLBACK_URL=
# Webhook: point the Paystack dashboard at
#   https://<your-domain>/api/payments/paystack/webhook
# It is authenticated with PAYSTACK_SECRET_KEY (HMAC-SHA512 signature).

# Shared secret for /api/cron/housekeeping (expire booking holds + Airbnb
# iCal sync). Point a scheduler at it every ~15 min with
# "Authorization: Bearer <CRON_SECRET>". Generate: openssl rand -hex 32
CRON_SECRET=
